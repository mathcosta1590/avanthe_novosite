---
import { whatsapp, alvoDeConversao } from '../data/site.js';

const {
  title = 'Sua obra, pronta na data combinada.',
  text = 'Chame no WhatsApp e receba um diagnóstico técnico para o seu projeto.',
  cta = 'Falar no WhatsApp',
  href = whatsapp('Olá! Vim pelo site da Avanthe e quero um orçamento para a minha obra.'),
  tone = 'ink',
} = Astro.props;
---

<section class={`section section--tall cta section--${tone}`}>
  <div class="shell cta__inner" data-reveal-item>
    <h2 class="headline cta__title" set:html={title} />
    <p class="lede cta__text">{text}</p>
    <a
      class="btn cta__btn"
      href={href}
      target="_blank"
      rel="noopener"
      data-conversao={alvoDeConversao}
      data-origem="cta"
    >
      {cta}
      <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
        <path d="M9 1L13 5L9 9M13 5H0" stroke="currentColor" stroke-width="1.3"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .cta__inner {
    display: grid;
    gap: var(--space-l);
    justify-items: start;
  }

  .cta__title {
    max-width: 16ch;
  }

  .cta__text {
    max-width: 52ch;
  }

  .cta__btn {
    margin-top: var(--space-s);
  }
</style>
