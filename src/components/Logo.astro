---
/**
 * Assinatura da marca, vetorial e oficial (src/assets/logo-avanthe.svg).
 *
 * O SVG é injetado inline e teve o fill branco trocado por currentColor, então
 * um único arquivo serve o header claro e o rodapé escuro: a cor vem do
 * contexto. Inline também evita uma requisição e permite animar/ajustar por CSS.
 */
import wordmark from '../assets/logo-avanthe.svg?raw';

const { label = 'Avanthe Engenharia', sub = true } = Astro.props;
---

<span class="logo" role="img" aria-label={label}>
  <span class="logo__mark" set:html={wordmark} />
  {sub && <span class="logo__sub">engenharia</span>}
</span>

<style>
  .logo {
    display: inline-grid;
    justify-items: start;
    line-height: 1;
    color: currentColor;
  }

  .logo__mark {
    display: block;
    width: auto;
  }

  .logo__mark :global(svg) {
    display: block;
    height: 1.18rem;
    width: auto;
    overflow: visible;
  }

  .logo__sub {
    margin-top: 0.3em;
    font-size: 0.64rem;
    font-weight: 400;
    letter-spacing: 0.055em;
    opacity: 0.7;
  }
</style>
