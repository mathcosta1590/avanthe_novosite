---
/**
 * Assinatura da marca, vetorial e oficial.
 *
 * O lockup completo ("avanthe." sobre "engenharia") foi extraído do PDF
 * original da marca, em Codec Pro. Antes o "engenharia" era texto em Work Sans
 * que não correspondia à marca.
 *
 * `variant="mark"` usa só o "a.", para o rodapé.
 *
 * As letras usam currentColor e herdam a cor do contexto, então um arquivo
 * serve o header claro e o rodapé escuro. O ponto tem cor própria, o verde da
 * marca, ajustável pela variável --logo-dot.
 */
import lockup from '../assets/logo-avanthe.svg?raw';
import mark from '../assets/logo-mark.svg?raw';

const { label = 'Avanthe Engenharia', variant = 'full' } = Astro.props;
const isMark = variant === 'mark';
---

<span class="logo" data-variant={variant} role="img" aria-label={label}>
  <Fragment set:html={isMark ? mark : lockup} />
</span>

<style>
  .logo {
    display: inline-block;
    line-height: 0;
    color: currentColor;
  }

  .logo :global(svg) {
    display: block;
    height: 2.75rem;
    width: auto;
  }

  .logo[data-variant='mark'] :global(svg) {
    height: 2.6rem;
  }

  @media (max-width: 520px) {
    .logo :global(svg) {
      height: 2.2rem;
    }
  }
</style>
