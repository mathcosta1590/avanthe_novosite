---
import { services } from '../data/site.js';

const { items = services, resumido = false } = Astro.props;
---

<ul class="services">
  {
    items.map((service, i) => (
      <li class="services__item" data-reveal-item>
        <a class="services__card" href={`/${service.slug}`}>
          <span class="services__index">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="services__title">{service.title}</h3>
          {!resumido && <p class="services__text">{service.short}</p>}
          <span class="services__cue">
            Ver serviço
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
              <path d="M9 1L13 5L9 9M13 5H0" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .services__item {
    border-bottom: 1px solid var(--rule);
  }

  .services__item:not(:nth-child(2n)) {
    border-right: 1px solid var(--rule);
  }

  .services__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-l) var(--space-l) var(--space-l) 0;
    text-decoration: none;
    transition: background 0.3s var(--ease), padding-left 0.3s var(--ease);
  }

  .services__item:not(:nth-child(2n)) .services__card {
    padding-right: var(--space-xl);
  }

  .services__item:nth-child(2n) .services__card {
    padding-left: var(--space-l);
  }

  .services__index {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--navy-30);
    font-variant-numeric: tabular-nums;
  }

  .services__title {
    margin-top: var(--space-m);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .services__text {
    margin-top: var(--space-s);
    font-weight: 300;
    color: var(--navy-80);
    max-width: 44ch;
  }

  .services__cue {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy-60);
    transition: gap 0.25s var(--ease), color 0.25s var(--ease);
  }

  .services__card:hover .services__cue {
    gap: 0.95em;
    color: var(--navy);
  }

  .services__card:hover .services__title {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 680px) {
    .services {
      grid-template-columns: 1fr;
    }

    .services__item:not(:nth-child(2n)) {
      border-right: 0;
    }

    .services__item .services__card {
      padding: var(--space-l) 0;
    }
  }
</style>
