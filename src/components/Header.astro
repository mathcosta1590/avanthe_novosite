---
import Logo from './Logo.astro';
import { nav } from '../data/site.js';

const { bare = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const isCurrent = (href) => path === href;
const isSection = (item) =>
  isCurrent(item.href) || (item.children ?? []).some((c) => isCurrent(c.href));
---

<header class="site-header" data-cabecalho data-bare={bare ? 'true' : 'false'}>
  <div class="shell site-header__inner">
    {
      /* Na landing de campanha a marca não é link: a regra da página proíbe
         qualquer saída que não seja o formulário de orçamento. */
      bare ? (
        <span class="site-header__brand">
          <Logo />
        </span>
      ) : (
        <a class="site-header__brand" href="/" aria-label="Avanthe Engenharia, página inicial">
          <Logo />
        </a>
      )
    }

    {
      !bare && (
        <>
          <nav class="site-nav" aria-label="Navegação principal">
            <ul class="site-nav__list">
              {nav.map((item) =>
                item.children ? (
                  <li class="site-nav__item site-nav__item--has-menu">
                    <button
                      type="button"
                      class="site-nav__link site-nav__trigger"
                      aria-expanded="false"
                      aria-current={isSection(item) ? 'true' : undefined}
                      data-menu-trigger
                    >
                      {item.label}
                      <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true">
                        <path d="M1 1L4.5 4.5L8 1" stroke="currentColor" stroke-width="1.3" />
                      </svg>
                    </button>
                    <ul class="site-nav__menu">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            aria-current={isCurrent(child.href) ? 'page' : undefined}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li class="site-nav__item">
                    <a
                      class="site-nav__link"
                      href={item.href}
                      aria-current={isCurrent(item.href) ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                )
              )}
            </ul>
          </nav>

          <a class="btn site-header__cta" href="/contato">Solicitar orçamento</a>

          <button
            type="button"
            class="site-header__toggle"
            aria-expanded="false"
            aria-controls="menu-mobile"
            data-nav-toggle
          >
            <span class="visually-hidden">Abrir menu</span>
            <span class="site-header__bars" aria-hidden="true"></span>
          </button>
        </>
      )
    }

    {bare && <span class="site-header__tag">Engenharia e obras · Curitiba</span>}
  </div>

  {
    !bare && (
      <div class="menu-mobile" id="menu-mobile" hidden data-nav-panel>
        <div class="shell">
          <ul class="menu-mobile__list">
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
                {item.children && (
                  <ul class="menu-mobile__sub">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
          <a class="btn menu-mobile__cta" href="/contato">Solicitar orçamento</a>
        </div>
      </div>
    )
  }
</header>

<style>
  /* Header sólido, não fixo no scroll. */
  /* Gruda no topo para poder se recolher na rolagem. O z-index fica acima do
     conteúdo e abaixo do overlay de sucesso dos formulários. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    min-height: 96px;
    transition: min-height 0.3s var(--ease);
  }

  /* Encolhe depois dos primeiros pixels de rolagem, devolvendo tela. */
  .site-header[data-compacto] .site-header__inner {
    min-height: 68px;
  }

  .site-header[data-compacto] .logo svg {
    height: 2.1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__inner { transition: none; }
  }

  .site-header__brand {
    text-decoration: none;
    margin-right: auto;
  }

  .site-header__tag {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy-60);
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-nav__item {
    position: relative;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--step-0);
    font-weight: 400;
    text-decoration: none;
    color: var(--navy);
    background: none;
    border: 0;
    padding: 0.4em 0;
    opacity: 0.78;
    transition: opacity 0.2s var(--ease);
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current] {
    opacity: 1;
  }

  .site-nav__link[aria-current] {
    font-weight: 500;
  }

  .site-nav__menu {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: -1rem;
    min-width: 232px;
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
    background: var(--paper-pure);
    border: 1px solid var(--rule);
    border-radius: 3px;
    box-shadow: 0 18px 42px -24px rgba(18, 33, 61, 0.45);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0.2s;
    z-index: 30;
  }

  .site-nav__item--has-menu:hover .site-nav__menu,
  .site-nav__item--has-menu:focus-within .site-nav__menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-nav__menu a {
    display: block;
    padding: 0.6rem 1.15rem;
    font-size: var(--step-0);
    text-decoration: none;
    color: var(--navy);
    opacity: 0.8;
    transition: background 0.18s var(--ease), opacity 0.18s var(--ease);
  }

  .site-nav__menu a:hover,
  .site-nav__menu a[aria-current='page'] {
    background: rgba(18, 33, 61, 0.05);
    opacity: 1;
  }

  .site-header__cta {
    padding: 0.7em 1.35em;
    font-size: var(--step--1);
  }

  .site-header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
  }

  .site-header__bars,
  .site-header__bars::before,
  .site-header__bars::after {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--navy);
    transition: transform 0.25s var(--ease), opacity 0.2s var(--ease);
  }

  .site-header__bars::before,
  .site-header__bars::after {
    content: '';
    position: relative;
  }

  .site-header__bars::before {
    top: -6px;
  }

  .site-header__bars::after {
    top: 4.5px;
  }

  [aria-expanded='true'] .site-header__bars {
    transform: rotate(45deg);
  }

  [aria-expanded='true'] .site-header__bars::before {
    opacity: 0;
  }

  [aria-expanded='true'] .site-header__bars::after {
    top: -1.5px;
    transform: rotate(-90deg);
  }

  .menu-mobile {
    border-bottom: 1px solid var(--rule);
    padding-block: var(--space-m) var(--space-l);
    background: var(--paper);
  }

  .menu-mobile__list {
    list-style: none;
    margin: 0 0 var(--space-l);
    padding: 0;
  }

  .menu-mobile__list > li + li {
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }

  .menu-mobile__list a {
    display: block;
    padding: 0.35rem 0;
    font-size: var(--step-1);
    font-weight: 400;
    text-decoration: none;
  }

  .menu-mobile__sub {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0 0 0 var(--space-s);
    border-left: 1px solid var(--rule);
  }

  .menu-mobile__sub a {
    font-size: var(--step-0);
    color: var(--navy-80);
  }

  .menu-mobile__cta {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .site-nav,
    .site-header__cta {
      display: none;
    }

    .site-header__toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const panel = document.querySelector('[data-nav-panel]');

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
      toggle.querySelector('.visually-hidden').textContent = open ? 'Abrir menu' : 'Fechar menu';
    });
  }

  /* O dropdown de serviços abre por hover/focus no CSS; o clique no botão
     leva para a primeira página da seção, para quem navega por toque. */
  document.querySelectorAll('[data-menu-trigger]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const first = trigger.parentElement?.querySelector('.site-nav__menu a');
      if (first) window.location.href = first.getAttribute('href');
    });
  });
</script>
