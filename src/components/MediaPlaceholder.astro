---
/**
 * Foto de obra, ou bloco de cor sólida no lugar dela enquanto a foto não
 * existe — a legenda diz exatamente qual imagem vai entrar ali, em vez de
 * banco de imagens genérico.
 *
 * As fotos saem em cor. O briefing previa preto e branco para unificar
 * material de celular com material profissional, mas em obra de reforma o
 * acabamento é o argumento de venda: o tom da madeira, o mármore, o
 * revestimento. Dessaturar joga fora justamente o que convence.
 */
const {
  caption,
  src,
  alt = '',
  ratio = '4 / 3',
  tone = 'navy',
  width,
  height,
  /**
   * Imagem acima da dobra. Carrega de imediato e com prioridade, porque
   * costuma ser o LCP da página — e LCP ruim pesa no Quality Score do Ads.
   */
  priority = false,
} = Astro.props;
---

<figure class="media" data-tone={tone} style={`--ratio: ${ratio}`}>
  {
    src ? (
      <img
        class="media__img"
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding={priority ? 'sync' : 'async'}
      />
    ) : (
      <div class="media__block" aria-hidden="true" />
    )
  }
  {!src && <figcaption class="media__caption">[ foto — {caption} ]</figcaption>}
</figure>

<style>
  .media {
    position: relative;
    margin: 0;
  }

  .media__block,
  .media__img {
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }

  .media[data-tone='navy'] .media__block {
    background: var(--navy);
  }

  .media[data-tone='ink'] .media__block {
    background: var(--ink);
  }

  .media__img {
    background: var(--navy-12);
  }

  .media__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-m);
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.06em;
    color: rgba(245, 245, 243, 0.55);
  }
</style>
