---
import Logo from './Logo.astro';
import { site, footerLinks } from '../data/site.js';

const { bare = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    {
      !bare && (
        <div class="site-footer__top">
          <div class="site-footer__brand">
            <Logo variant="mark" />
            <p class="site-footer__tagline">{site.tagline}</p>
            <div class="site-footer__redes">
              <a
                class="site-footer__social"
                href={site.instagram}
                target="_blank"
                rel="noopener"
                aria-label="Instagram da Avanthe"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.2" cy="6.8" r="1" />
                </svg>
              </a>
              <a
                class="site-footer__social"
                href={`https://wa.me/${site.whatsapp.number}`}
                target="_blank"
                rel="noopener"
                aria-label={`WhatsApp da Avanthe, ${site.whatsapp.display}`}
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.004c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24Zm-2.6 4.1c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02s.87 2.34.99 2.5c.12.16 1.7 2.6 4.13 3.65.58.25 1.03.4 1.38.51.58.18 1.1.16 1.52.1.46-.07 1.43-.59 1.63-1.15.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.37-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.46-.39-.4-.54-.41-.14 0-.3-.01-.46-.01Z" />
                </svg>
              </a>
            </div>
          </div>

          {footerLinks.map((group) => (
            <nav class="site-footer__group" aria-label={group.title}>
              <h2 class="site-footer__title">{group.title}</h2>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))}

          <div class="site-footer__group">
            <h2 class="site-footer__title">Contato</h2>
            <ul>
              <li>
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </li>
              <li>
                <a href="/contato">Solicitar orçamento</a>
              </li>
              <li class="site-footer__address">
                {/* Espaço inquebrável antes do número, para ele nunca orfanar
                    numa linha só, em nenhuma largura. */}
                <span set:html={site.address.street.replace(/,\s+(\d)/, ',&nbsp;$1')} />
                <br />
                {site.address.district}, {site.address.city} - {site.address.state}
              </li>
            </ul>
          </div>
        </div>
      )
    }

    <div class="site-footer__bottom">
      <p>
        © {year} {site.legalName} · CNPJ {site.cnpj}
      </p>
      <p>
        <a href="/politica-de-privacidade">Política de privacidade</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: var(--paper);
    padding-block: var(--space-2xl) var(--space-l);
    margin-top: auto;
  }

  .site-footer__top {
    display: grid;
    /* A última coluna leva o endereço, que é a linha mais longa do rodapé.
       Com quatro colunas iguais faltavam 4px e o número da rua caía sozinho
       numa terceira linha. */
    grid-template-columns: 1.5fr 1fr 1fr 1.25fr;
    gap: var(--space-xl) var(--space-l);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid rgba(245, 245, 243, 0.16);
  }

  .site-footer__tagline {
    margin-top: var(--space-l);
    font-size: var(--step-0);
    font-weight: 400;
    color: var(--paper);
  }

  .site-footer__redes {
    display: flex;
    gap: var(--space-2xs);
    margin-top: var(--space-l);
  }

  .site-footer__social {
    display: inline-flex;
    padding: 0.55rem;
    color: rgba(245, 245, 243, 0.7);
    border: 1px solid rgba(245, 245, 243, 0.24);
    border-radius: 3px;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .site-footer__social:hover {
    color: var(--paper);
    border-color: var(--paper);
  }

  .site-footer__title {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgba(245, 245, 243, 0.5);
    margin-bottom: var(--space-s);
  }

  .site-footer__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__group li + li {
    margin-top: 0.55rem;
  }

  .site-footer__group a {
    font-weight: 300;
    text-decoration: none;
    color: rgba(245, 245, 243, 0.85);
    transition: color 0.2s var(--ease);
  }

  .site-footer__group a:hover {
    color: var(--paper);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-footer__address {
    font-weight: 300;
    color: rgba(245, 245, 243, 0.6);
    line-height: 1.5;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
    padding-top: var(--space-l);
    font-size: var(--step--1);
    font-weight: 300;
    color: rgba(245, 245, 243, 0.55);
  }

  .site-footer__bottom p:last-child {
    margin-left: auto;
  }

  .site-footer__bottom a {
    color: inherit;
  }

  @media (max-width: 900px) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .site-footer__top {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }

    .site-footer__bottom p:last-child {
      margin-left: 0;
    }
  }
</style>
