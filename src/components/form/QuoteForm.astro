---
import Field from './Field.astro';
import HiddenContext from './HiddenContext.astro';
import Honeypot from './Honeypot.astro';
import SuccessOverlay from './SuccessOverlay.astro';
import { site, serviceOptions } from '../../data/site.js';

const {
  /**
   * Gate de triagem: pergunta o que a pessoa precisa antes de exibir os campos.
   * Ligado em /contato. Desligado na landing de campanha, onde a regra de página
   * proíbe qualquer link de saída para outras páginas do site.
   */
  id = 'form-orcamento',
  successId = 'sucesso-orcamento',
  /** Prefixo de id dos campos: permite o mesmo formulário duas vezes na página. */
  idPrefix = 'campo',
  /**
   * Na landing de campanha não pode haver link de saída, então o aviso de
   * triagem aparece só como texto, sem o atalho para o outro formulário.
   */
  allowExitLinks = true,
} = Astro.props;

const sendTo = `${site.ads.conversionId}/${site.ads.conversionLabel}`;
---

<form
  class="form"
  id={id}
  name="orcamento"
  method="POST"
  action="/contato"
  enctype="multipart/form-data"
  data-avanthe-form
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-conversion="true"
  data-conversion-target={sendTo}
  data-success={successId}
>
  <input type="hidden" name="form-name" value="orcamento" />
  <Honeypot />
  <HiddenContext />

  <Field idPrefix={idPrefix} name="nome" label="Nome" required autocomplete="name" placeholder="Seu nome completo" />

  <div class="form__row">
    <Field
      idPrefix={idPrefix}
      name="telefone"
      label="Telefone / WhatsApp"
      type="tel"
      required
      validate="phone"
      autocomplete="tel"
      placeholder="(41) 90000-0000"
    />
    <Field
      idPrefix={idPrefix}
      name="email"
      label="E-mail"
      type="email"
      required
      autocomplete="email"
      placeholder="voce@empresa.com.br"
    />
  </div>

  <div class="form__row">
    <Field idPrefix={idPrefix} name="tipo_servico" label="Tipo de serviço" type="select" required options={serviceOptions} />
    <Field
      idPrefix={idPrefix}
      name="tipo_imovel"
      label="Tipo de imóvel"
      type="select"
      required
      options={['Residencial', 'Comercial']}
    />
  </div>

  <div class="field">
    <span class="field__label">
      Projeto ou planta<span class="field__optional"> (opcional)</span>
    </span>
    <div class="file">
      <button type="button" class="file__button" data-file-trigger>Escolher arquivo</button>
      <span class="file__name" data-file-name>Nenhum arquivo selecionado</span>
      <input
        class="file__input"
        type="file"
        id={`${idPrefix}-projeto`}
        name="projeto"
        accept=".pdf,.png,.jpg,.jpeg,.webp,image/*,application/pdf"
        tabindex="-1"
      />
    </div>
    <p class="field__hint">PDF ou imagem, até 8 MB. Acelera o diagnóstico, mas não é obrigatório.</p>
    <p class="field__error" role="alert" aria-live="polite"></p>
  </div>

  <Field
    idPrefix={idPrefix}
    name="mensagem"
    label="Mensagem"
    type="textarea"
    placeholder="Conte um pouco mais, se quiser."
    misroute={true}
  />

  <div class="notice" hidden data-misroute-notice>
    <p data-misroute-text></p>
    <div class="notice__actions">
      {allowExitLinks && <a href="/recrutamento" data-misroute-link>Ir para o formulário certo</a>}
    </div>
  </div>

  <button type="submit" class="btn form__submit">Solicitar orçamento</button>
  <p class="form__status" role="status" aria-live="polite" data-form-status></p>
</form>

<SuccessOverlay
  id={successId}
  title="Recebemos seu pedido."
  text="Um engenheiro da Avanthe vai analisar as informações e retornar em até um dia útil. Se preferir adiantar a conversa, continue no WhatsApp."
  whatsapp={true}
/>
