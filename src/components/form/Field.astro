---
const {
  name,
  label,
  type = 'text',
  required = false,
  placeholder = '',
  autocomplete,
  options = null,
  rows = 4,
  hint = null,
  validate = null,
  misroute = false,
  idPrefix = 'campo',
} = Astro.props;

const id = `${idPrefix}-${name}`;
const isTextarea = type === 'textarea';
const isSelect = type === 'select';
---

<div class="field">
  <label class="field__label" for={id}>
    {label}
    {!required && <span class="field__optional"> (opcional)</span>}
  </label>

  {
    isSelect ? (
      <select
        class="field__control"
        id={id}
        name={name}
        required={required}
        data-validate={validate ?? undefined}
      >
        <option value="">Selecione</option>
        {options.map((opt) => (
          <option value={opt}>{opt}</option>
        ))}
      </select>
    ) : isTextarea ? (
      <textarea
        class="field__control"
        id={id}
        name={name}
        rows={rows}
        required={required}
        placeholder={placeholder}
        data-validate={validate ?? undefined}
        data-misroute-source={misroute ? 'true' : undefined}
      />
    ) : (
      <input
        class="field__control"
        id={id}
        name={name}
        type={type}
        required={required}
        placeholder={placeholder}
        autocomplete={autocomplete}
        data-validate={validate ?? undefined}
      />
    )
  }

  {hint && <p class="field__hint">{hint}</p>}
  <p class="field__error" role="alert" aria-live="polite"></p>
</div>
