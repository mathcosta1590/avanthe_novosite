---
import MediaPlaceholder from './MediaPlaceholder.astro';

const { project } = Astro.props;
const isDraft = project.status !== 'complete';
---

{
  isDraft ? (
    <article class="project-card project-card--draft">
      <MediaPlaceholder caption={project.name} ratio="3 / 2" tone="ink" />
      <div class="project-card__body">
        <h3 class="project-card__name">{project.name}</h3>
        <p class="project-card__meta">{project.type}</p>
        <p class="project-card__pending">Registro técnico desta obra em levantamento.</p>
      </div>
    </article>
  ) : (
    <article class="project-card">
      <a class="project-card__link" href={`/portfolio/${project.slug}`}>
        <MediaPlaceholder caption={project.name} ratio="3 / 2" />
        <div class="project-card__body">
          <h3 class="project-card__name">{project.name}</h3>
          <p class="project-card__meta">{project.type}</p>
          <p class="project-card__line">{project.positioning}</p>
        </div>
      </a>
    </article>
  )
}

<style>
  .project-card {
    height: 100%;
  }

  .project-card__link {
    display: block;
    height: 100%;
    text-decoration: none;
  }

  .project-card__body {
    padding-top: var(--space-m);
  }

  .project-card__name {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .project-card__link:hover .project-card__name {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .project-card__meta {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy-60);
  }

  .project-card__line {
    margin-top: var(--space-s);
    font-weight: 300;
    color: var(--navy-80);
    max-width: 42ch;
  }

  .project-card__pending {
    margin-top: var(--space-s);
    font-weight: 300;
    font-style: italic;
    color: var(--navy-60);
  }

  .project-card--draft {
    opacity: 0.85;
  }
</style>
