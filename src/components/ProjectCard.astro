---
import MediaPlaceholder from './MediaPlaceholder.astro';

const { project } = Astro.props;
const isDraft = project.status !== 'complete';
const cover = project.gallery?.[0] ?? null;
const emAndamento = project.stage === 'andamento';
---

{
  isDraft ? (
    <article class="project-card project-card--draft">
      <div class="project-card__media">
        <MediaPlaceholder caption={project.name} ratio="3 / 2" tone="ink" />
        <span class="project-card__badge">Em levantamento</span>
      </div>
      <div class="project-card__body">
        <h3 class="project-card__name">{project.name}</h3>
        <p class="project-card__meta">{project.type}</p>
        <p class="project-card__pending">
          Dados e fotos desta obra ainda estão sendo levantados. A página entra no ar em seguida.
        </p>
      </div>
    </article>
  ) : (
    <article class="project-card">
      <a class="project-card__link" href={`/portfolio/${project.slug}`}>
        <div class="project-card__media">
        <MediaPlaceholder
          caption={project.name}
          src={cover?.src}
          alt={cover?.alt}
          ratio="3 / 2"
        />
        {emAndamento && <span class="project-card__badge project-card__badge--live">Em andamento</span>}
        </div>
        <div class="project-card__body">
          <h3 class="project-card__name">{project.name}</h3>
          <p class="project-card__meta">{project.type}</p>
          <p class="project-card__line">{project.positioning}</p>
        </div>
      </a>
    </article>
  )
}

<style>
  .project-card {
    height: 100%;
  }

  .project-card__link {
    display: block;
    height: 100%;
    text-decoration: none;
  }

  .project-card__body {
    padding-top: var(--space-m);
  }

  .project-card__name {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .project-card__link:hover .project-card__name {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .project-card__meta {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy-60);
  }

  .project-card__line {
    margin-top: var(--space-s);
    font-weight: 300;
    color: var(--navy-80);
    max-width: 42ch;
  }

  .project-card__pending {
    margin-top: var(--space-s);
    font-weight: 300;
    font-style: italic;
    color: var(--navy-60);
  }

  /* Sem afordância de clique: nada aqui abre ainda. */
  .project-card--draft {
    cursor: default;
  }

  .project-card__media {
    position: relative;
  }

  .project-card__badge--live {
    background: rgba(18, 33, 61, 0.82);
    border-color: transparent;
  }

  .project-card__badge {
    position: absolute;
    top: var(--space-s);
    left: var(--space-s);
    padding: 0.3em 0.7em;
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper);
    background: rgba(245, 245, 243, 0.14);
    border: 1px solid rgba(245, 245, 243, 0.3);
    border-radius: 2px;
  }

  .project-card--draft .project-card__name {
    color: var(--navy-60);
    font-weight: 500;
  }

  .project-card--draft .project-card__meta {
    color: var(--navy-30);
  }
</style>
