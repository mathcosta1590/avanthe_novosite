---
/**
 * Mosaico de obras logo abaixo do hero.
 *
 * Quem entra no site precisa ver obra entregue antes de ler qualquer
 * argumento: a foto filtra o cliente melhor do que o texto. Por isso vem alto
 * na página, em largura total, com legenda mínima.
 */
const pecas = [
  { src: '/vitrine/v-1.jpg', alt: 'Salão da cafeteria The Best Coffee após a reforma', obra: 'The Best Coffee', tipo: 'Franquia comercial', href: '/portfolio/the-best-coffee', largo: true },
  { src: '/vitrine/v-2.jpg', alt: 'Estar integrado do Apartamento 301', obra: 'Apartamento 301', tipo: 'Reforma residencial', href: '/portfolio/apartamento-301' },
  { src: '/vitrine/v-3.jpg', alt: 'Área administrativa da Ruffino após o retrofit', obra: 'Ruffino', tipo: 'Retrofit comercial', href: '/portfolio/reforma-comercial-ruffino' },
  { src: '/vitrine/v-4.jpg', alt: 'Varanda integrada do Apartamento 301', obra: 'Apartamento 301', tipo: 'Reforma residencial', href: '/portfolio/apartamento-301' },
  { src: '/vitrine/v-5.jpg', alt: 'Ambiente de mesas da cafeteria', obra: 'The Best Coffee', tipo: 'Franquia comercial', href: '/portfolio/the-best-coffee' },
];
---

<section class="vitrine" aria-label="Obras entregues">
  <ul class="vitrine__grid">
    {
      pecas.map((p, i) => (
        <li class="vitrine__item" data-largo={p.largo ? 'true' : 'false'} data-reveal-item>
          <a class="vitrine__link" href={p.href}>
            <img
              src={p.src}
              alt={p.alt}
              width={p.largo ? 1800 : 900}
              height={p.largo ? 1012 : 900}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="vitrine__tag">
              <strong>{p.obra}</strong>
              <span>{p.tipo}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="shell vitrine__rodape">
    <a class="link" href="/portfolio">
      Ver todas as obras
      <span class="link__arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .vitrine {
    padding-block: 0 var(--space-2xl);
  }

  .vitrine__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vitrine__item {
    position: relative;
    overflow: hidden;
    background: var(--navy-12);
  }

  .vitrine__item[data-largo='true'] {
    grid-column: span 4;
  }

  .vitrine__link {
    display: block;
    position: relative;
  }

  .vitrine__item img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .vitrine__item[data-largo='true'] img {
    aspect-ratio: 16 / 9;
    max-height: 74vh;
  }

  .vitrine__link:hover img {
    transform: scale(1.035);
  }

  /* Legenda mínima: aparece sobre um véu curto, só no pé da imagem. */
  .vitrine__tag {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 0.15em;
    padding: var(--space-m);
    color: var(--paper);
    background: linear-gradient(to top, rgba(16, 36, 73, 0.78), transparent);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }

  .vitrine__link:hover .vitrine__tag,
  .vitrine__link:focus-visible .vitrine__tag {
    opacity: 1;
  }

  .vitrine__tag strong {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .vitrine__tag span {
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .vitrine__rodape {
    margin-top: var(--space-l);
  }

  /* Em toque não há hover, então a legenda fica sempre visível. */
  @media (hover: none) {
    .vitrine__tag {
      opacity: 1;
    }
  }

  @media (max-width: 720px) {
    .vitrine__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .vitrine__item[data-largo='true'] {
      grid-column: span 2;
    }
  }
</style>
