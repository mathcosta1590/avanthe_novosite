---
const { items, title } = Astro.props;
---

<ol class="steps" aria-label={title}>
  {
    items.map((step, i) => (
      <li class="steps__item" data-reveal-item>
        <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="steps__title">{step.title}</h3>
        <p class="steps__text">{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-l);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .steps__item {
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  .steps__num {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--navy-30);
    font-variant-numeric: tabular-nums;
  }

  .steps__title {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .steps__text {
    margin-top: var(--space-2xs);
    font-weight: 300;
    color: var(--navy-80);
  }

  :global(.section--ink) .steps__item,
  :global(.section--navy) .steps__item {
    border-color: rgba(245, 245, 243, 0.22);
  }

  :global(.section--ink) .steps__num,
  :global(.section--navy) .steps__num {
    color: rgba(245, 245, 243, 0.5);
  }

  :global(.section--ink) .steps__text,
  :global(.section--navy) .steps__text {
    color: rgba(245, 245, 243, 0.78);
  }
</style>
