---
const { items, title } = Astro.props;
---

<ol class="steps" aria-label={title} data-etapas style={`--n: ${items.length}`}>
  {
    items.map((step, i) => (
      <li class="steps__item" data-etapa style={`--i: ${i}`}>
        <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="steps__title">{step.title}</h3>
        <p class="steps__text">{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-l);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Em tela larga as colunas acompanham a quantidade de etapas, em vez de o
     auto-fit decidir. Com cinco etapas e quatro colunas, a última ficava
     sozinha numa linha — e numa sequência isso lê como se faltasse algo. */
  @media (min-width: 1080px) {
    .steps {
      grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr));
      gap: var(--space-m);
    }
  }

  /*
   * A ordem é contada só pelo acendimento, uma etapa por vez.
   *
   * Havia também uma linha escura correndo sobre a régua de cada etapa. Ela
   * caía colada no título da seção e lia como sublinhado dele, não como
   * trilha — o recurso contava a ordem para quem já sabia que era uma trilha,
   * e confundia todo o resto.
   */
  .steps__item {
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  [data-etapas][data-andando] .steps__item {
    opacity: 1;
  }

  [data-etapas][data-andou] .steps__item {
    transition: opacity 0.4s var(--ease) calc(var(--i) * 420ms + 180ms);
  }

  [data-etapas][data-andou] .steps__item:not([data-aceso]) {
    opacity: 0.42;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-etapas] .steps__item { opacity: 1 !important; }
  }

  .steps__num {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--navy-30);
    font-variant-numeric: tabular-nums;
  }

  .steps__title {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .steps__text {
    margin-top: var(--space-2xs);
    font-weight: 300;
    color: var(--navy-80);
  }

  :global(.section--ink) .steps__item,
  :global(.section--navy) .steps__item {
    border-color: rgba(245, 245, 243, 0.22);
  }

  :global(.section--ink) .steps__num,
  :global(.section--navy) .steps__num {
    color: rgba(245, 245, 243, 0.5);
  }

  :global(.section--ink) .steps__text,
  :global(.section--navy) .steps__text {
    color: rgba(245, 245, 243, 0.78);
  }
</style>
