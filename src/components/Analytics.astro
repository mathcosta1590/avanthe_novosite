---
import { site } from '../data/site.js';

/**
 * Google Ads e Google Analytics 4.
 *
 * Os dois usam o mesmo gtag.js, carregado uma vez só. Cada ID entra num
 * `config` próprio, e nenhum script é emitido enquanto o ID não estiver
 * preenchido de verdade — assim o site não carrega tag quebrada antes das
 * contas existirem.
 *
 * A conversão do Ads NÃO é disparada aqui: quem dispara é o envio
 * bem-sucedido do formulário de orçamento, em src/scripts/forms.js. É o que
 * garante que currículo e oferta de fornecedor não entrem na conta.
 */
const valido = (id) => Boolean(id) && !id.includes('XXX');

const ads = valido(site.ads.conversionId) ? site.ads.conversionId : null;
const ga4 = valido(site.ga4) ? site.ga4 : null;
const principal = ads || ga4;
---

{
  principal && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${principal}`} />
      <script
        is:inline
        set:html={`
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
${ads ? `gtag('config', '${ads}');` : ''}
${ga4 ? `gtag('config', '${ga4}');` : ''}
`}
      />
    </>
  )
}
