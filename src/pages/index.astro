---
import Base from '../layouts/Base.astro';
import Stats from '../components/Stats.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Steps from '../components/Steps.astro';
import Planta from '../components/Planta.astro';
import { METODO } from '../data/metodo.js';
import CtaSection from '../components/CtaSection.astro';

---

<Base
  title={null}
  description="Construção, reforma e retrofit em Curitiba. 100% das obras entregues no prazo, responsabilidade técnica direta e relatório semanal de andamento."
>

  <!-- Hero -->
  <section class="hero">
    <div class="shell hero__inner">
      <h1 class="hero__text display" data-subir>
        Sua obra sai do papel <strong>exatamente como foi planejada</strong>.
      </h1>
      <p class="lede hero__lede" data-reveal-item>
        Na Avanthe, há <strong>metodologia</strong> e <strong>processo</strong>. Vemos beleza
        nisso, e por isso respeitamos cada etapa. Nossa fundação é feita de tecnologia,
        compromisso e pessoas.
      </p>
      <div class="hero__actions" data-reveal-item>
        <a class="btn" href="/contato">Solicitar orçamento</a>
        <a class="link" href="/portfolio">
          Ver obras entregues
          <span class="link__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Números -->
  <section class="section section--tight">
    <div class="shell">
      <Stats />
    </div>
  </section>

  <!-- Manifesto: um dos dois momentos de quase-preto da página. -->
  <section class="section section--tall section--ink">
    <div class="shell manifesto">
      <blockquote class="manifesto__quote" data-reveal-item>
        <p class="headline">"Todo mundo diz que faz alto padrão."</p>
        <p class="manifesto__turn subtitle">
          Mas se você precisa dizer que é alto padrão, <strong>você não é</strong>.
        </p>
      </blockquote>

      <div class="manifesto__body prose" data-reveal-item>
        <p>
          Alto padrão é ter um engenheiro acompanhando sua obra. É ter cronograma, fluxo financeiro
          organizado, RT emitida, seguro de obra, contrato sério e nota fiscal de cada serviço.
          Acabamento bonito é só uma parte disso, a parte que todo mundo mostra e ninguém sustenta.
        </p>
        <p>
          Na Avanthe, você deixa a chave e volta na data combinada. A obra vai estar pronta.{' '}
          <strong>Você não precisa se preocupar com nada.</strong>
        </p>
      </div>
    </div>
  </section>

  <!--
    Como trabalhamos.

    Vem logo depois do manifesto de propósito: o manifesto acusa o mercado de
    não ter engenheiro, cronograma, RT nem contrato, e esta seção mostra isso
    acontecendo. Acusação e prova, uma embaixo da outra.

    A planta é textura, não informação: desenhada em traço fino atrás das
    etapas, atravessando a seção inteira.
  -->
  <section class="section section--tall metodo">
    <div class="metodo__fundo" aria-hidden="true">
      <Planta fundo={true} />
    </div>
    <div class="shell">
      <div class="section-head" data-reveal-item>
        <span class="eyebrow">Como trabalhamos</span>
        <h2 class="headline section-head__title" data-subir>
          Cinco etapas, sempre na mesma ordem.
        </h2>
      </div>
      <Steps title="Como trabalhamos" items={METODO} />
    </div>
  </section>

  <!-- Serviços -->
  <section class="section section--tall">
    <div class="shell">
      <div class="section-head" data-reveal-item>
        <span class="eyebrow">O que fazemos</span>
        <h2 class="headline section-head__title">Quatro frentes, um mesmo rigor.</h2>
      </div>
      <ServiceGrid />
    </div>
  </section>

  <CtaSection
    title="Você deixa a chave e volta na data combinada."
    text="Preencha o formulário e receba um diagnóstico técnico para o seu projeto. Respondemos em até um dia útil."
    tone="navy"
  />
</Base>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }

  .hero__text {
    max-width: 16ch;
  }

  .hero__lede {
    margin-top: var(--space-l);
    max-width: 54ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m) var(--space-xl);
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .metodo {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .metodo__fundo {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  /* O desenho sangra para fora da coluna de leitura: dentro dela viraria um
     quadro, e a intenção é textura. */
  .metodo__fundo > :global(.planta) {
    width: min(132%, 86rem);
  }

  @media (max-width: 760px) {
    .metodo__fundo > :global(.planta) {
      width: 190%;
    }
  }

  .section-head {
    margin-bottom: var(--space-xl);
  }

  .section-head__title {
    max-width: 16ch;
  }

  .manifesto {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-xl) var(--space-2xl);
    align-items: start;
  }

  .manifesto__quote {
    margin: 0;
  }

  .manifesto__turn {
    margin-top: var(--space-l);
    color: rgba(245, 245, 243, 0.62);
    max-width: 22ch;
  }

  .manifesto__turn strong {
    color: var(--paper);
    font-weight: 600;
  }

  .manifesto__body {
    padding-top: var(--space-2xs);
  }





  @media (max-width: 860px) {
    .manifesto {
      grid-template-columns: 1fr;
    }
  }
</style>
