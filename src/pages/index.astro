---
import Base from '../layouts/Base.astro';
import Stats from '../components/Stats.astro';
import Vitrine from '../components/Vitrine.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import CtaSection from '../components/CtaSection.astro';

/**
 * Abordagem do hero.
 *   'dividido' — texto à esquerda, foto sangrando à direita, em força total.
 *   'imersivo' — foto em largura total com véu escuro e texto em branco.
 * Trocar aqui troca a home inteira.
 */
const HERO = 'dividido';
---

<Base
  title={null}
  description="Construção, reforma e retrofit em Curitiba. 8 obras entregues, 100% no prazo, responsabilidade técnica direta e relatório semanal de andamento."
>
  <link
    slot="preload"
    rel="preload"
    as="image"
    href={HERO === 'dividido' ? '/hero-painel.jpg' : '/hero-largo.jpg'}
    fetchpriority="high"
  />

  <!-- Hero -->
  <section class="hero" data-variante={HERO}>
    {
      HERO === 'imersivo' && (
        <div class="hero__fundo" aria-hidden="true">
          <img src="/hero-largo.jpg" alt="" width="2000" height="1125" fetchpriority="high" />
        </div>
      )
    }

    <div class="shell hero__inner">
      <div class="hero__texto">
        <h1 class="hero__text display" data-reveal-item>
          Sua obra sai do papel <strong>exatamente como foi planejada</strong>.
        </h1>
        <p class="lede hero__lede" data-reveal-item>
          Na Avanthe, há <strong>metodologia</strong> e <strong>processo</strong>. Vemos beleza
          nisso, e por isso respeitamos cada etapa. Nossa fundação é feita de tecnologia,
          compromisso e pessoas.
        </p>
        <div class="hero__actions" data-reveal-item>
          <a class="btn" href="/contato">Solicitar orçamento</a>
          <a class="link" href="/portfolio">
            Ver obras entregues
            <span class="link__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    {
      HERO === 'dividido' && (
        <div class="hero__painel">
          <img
            src="/hero-painel.jpg"
            alt="Cozinha do Apartamento 301, obra entregue pela Avanthe"
            width="1100"
            height="1375"
            fetchpriority="high"
          />
        </div>
      )
    }
  </section>

  <!-- Obras: a primeira coisa depois do hero -->
  <Vitrine />

  <!-- Números -->
  <section class="section section--tight">
    <div class="shell">
      <Stats />
    </div>
  </section>

  <!-- Manifesto: um dos dois momentos de quase-preto da página. -->
  <section class="section section--tall section--ink">
    <div class="shell manifesto">
      <blockquote class="manifesto__quote" data-reveal-item>
        <p class="headline">"Todo mundo diz que faz alto padrão."</p>
        <p class="manifesto__turn subtitle">
          Mas se você precisa dizer que é alto padrão, <strong>você não é</strong>.
        </p>
      </blockquote>

      <div class="manifesto__body prose" data-reveal-item>
        <p>
          Alto padrão é ter um engenheiro acompanhando sua obra. É ter cronograma, fluxo financeiro
          organizado, RT emitida, seguro de obra, contrato sério e nota fiscal de cada serviço.
          Acabamento bonito é só uma parte disso, a parte que todo mundo mostra e ninguém sustenta.
        </p>
        <p>
          Na Avanthe, você deixa a chave e volta na data combinada. A obra vai estar pronta.{' '}
          <strong>Você não precisa se preocupar com nada.</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- Serviços -->
  <section class="section section--tall">
    <div class="shell">
      <div class="section-head" data-reveal-item>
        <span class="eyebrow">O que fazemos</span>
        <h2 class="headline section-head__title">Quatro frentes, um mesmo rigor.</h2>
      </div>
      <ServiceGrid resumido={true} />
    </div>
  </section>

  <CtaSection
    title="Você deixa a chave e volta na data combinada."
    text="Preencha o formulário e receba um diagnóstico técnico para o seu projeto. Respondemos em até um dia útil."
    tone="navy"
  />
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
  }

  /* ---------- A: dividido ---------- */

  .hero[data-variante='dividido'] {
    display: grid;
    grid-template-columns: 1fr;
  }

  .hero[data-variante='dividido'] .hero__inner {
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }

  .hero__painel {
    display: none;
  }

  @media (min-width: 900px) {
    .hero[data-variante='dividido'] {
      grid-template-columns: minmax(0, 1fr) minmax(0, 38vw);
      align-items: stretch;
    }

    .hero[data-variante='dividido'] .hero__inner {
      max-width: calc(var(--shell) * 0.62);
      margin-inline: 0 0;
      padding-left: max(var(--gutter), calc((100vw - var(--shell)) / 2 + var(--gutter)));
      padding-right: var(--space-xl);
      display: flex;
      align-items: center;
    }

    .hero__painel {
      display: block;
      position: relative;
      overflow: hidden;
      min-height: clamp(30rem, 44vw, 40rem);
    }

    .hero__painel img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  /* ---------- B: imersivo ---------- */

  .hero[data-variante='imersivo'] {
    color: var(--paper);
  }

  .hero[data-variante='imersivo'] .hero__inner {
    padding-block: clamp(5rem, 14vw, 10rem);
  }

  .hero__fundo {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .hero__fundo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Véu escuro: o texto em branco precisa de base, e o navy da marca mantém a
     foto dentro da paleta em vez de virar um cinza qualquer. */
  .hero__fundo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(16, 36, 73, 0.92) 0%,
      rgba(16, 36, 73, 0.8) 42%,
      rgba(16, 36, 73, 0.45) 100%
    );
  }

  .hero[data-variante='imersivo'] .hero__lede {
    color: rgba(245, 245, 243, 0.82);
  }

  .hero[data-variante='imersivo'] .btn {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--navy);
  }

  .hero[data-variante='imersivo'] .link {
    border-color: rgba(245, 245, 243, 0.4);
  }

  /* ---------- comum ---------- */

  .hero__text {
    max-width: 16ch;
  }

  .hero[data-variante='dividido'] .hero__text {
    font-size: clamp(2.3rem, 3.6vw, 3.9rem);
    max-width: 14ch;
  }

  .hero[data-variante='dividido'] .hero__lede {
    max-width: 46ch;
  }

  .hero__lede {
    margin-top: var(--space-l);
    max-width: 54ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m) var(--space-xl);
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .section-head {
    margin-bottom: var(--space-xl);
  }

  .section-head__title {
    max-width: 16ch;
  }

  .manifesto {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-xl) var(--space-2xl);
    align-items: start;
  }

  .manifesto__quote {
    margin: 0;
  }

  .manifesto__turn {
    margin-top: var(--space-l);
    color: rgba(245, 245, 243, 0.62);
    max-width: 22ch;
  }

  .manifesto__turn strong {
    color: var(--paper);
    font-weight: 600;
  }

  .manifesto__body {
    padding-top: var(--space-2xs);
  }





  @media (max-width: 860px) {
    .manifesto {
      grid-template-columns: 1fr;
    }
  }
</style>
