---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site, whatsapp, alvoDeConversao } from '../data/site.js';

const MENSAGEM =
  'Olá! Vim pelo site da Avanthe e quero um orçamento para a minha obra.';
---

<Base
  title="Contato"
  description="Solicite um orçamento para construção, reforma, retrofit, regularização técnica ou gestão de obra em Curitiba. Resposta em até um dia útil."

  ogImage="/og/contato.jpg"
>
  <PageHero
    eyebrow="Contato"
    title="Comece pelo <strong>diagnóstico</strong>."
    lede="Chame no WhatsApp e fale direto com um engenheiro. Se tiver planta ou foto, mande junto: acelera o diagnóstico."
  />

  <section class="section section--tall">
    <div class="shell contato">
      <div class="contato__form">
        <!--
          Sem formulário, de propósito.

          O formulário pedia cinco campos obrigatórios de quem clicou num
          anúncio no celular só para saber um preço. Chegava lead, mas a
          barreira era alta demais para o volume que a campanha paga.

          O WhatsApp abre com a mensagem já escrita: o cliente não precisa
          decidir como começar, que é onde a maioria desiste.
        -->
        <div class="zap">
          <p class="zap__lede">
            Manda uma mensagem. Um engenheiro responde — não é atendente, não é robô.
          </p>

          <a
            class="btn zap__btn"
            href={whatsapp(MENSAGEM)}
            target="_blank"
            rel="noopener"
            data-conversao={alvoDeConversao}
            data-origem="contato"
          >
            Falar no WhatsApp
          </a>

          <p class="zap__numero">
            ou ligue <a href={`tel:+${site.whatsapp.number}`}>{site.whatsapp.display}</a>
          </p>

          <p class="zap__email">
            Prefere escrever? <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>

        <p class="contato__desvio">
          Currículo ou vaga? <a href="/recrutamento">Trabalhe conosco</a>. Quer fornecer
          material ou serviço? <a href="/fornecedores">Fornecedor parceiro</a>.
        </p>
      </div>

      <aside class="contato__aside">
        <div class="contato__block">
          <h2 class="contato__title">Como funciona depois do contato</h2>
          <ol class="contato__steps">
            <li>Um engenheiro responde no WhatsApp, em até um dia útil.</li>
            <li>Agendamos o diagnóstico técnico presencial, sempre em campo.</li>
            <li>Você recebe proposta com valores, prazo e escopo definidos com clareza.</li>
          </ol>
        </div>

        <div class="contato__block">
          <h2 class="contato__title">Onde estamos</h2>
          <p class="contato__text">
            {site.address.street}<br />
            {site.address.district}, {site.address.city} - {site.address.state}
          </p>
          <p class="contato__text">
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>

      </aside>
    </div>
  </section>

</Base>

<style>
  .zap {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
    padding-top: var(--space-s);
    border-top: 2px solid var(--navy);
  }

  .zap__lede {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 300;
    max-width: 32ch;
  }

  .zap__btn {
    font-size: var(--step-1);
    padding: var(--space-s) var(--space-xl);
  }

  .zap__numero,
  .zap__email {
    margin: 0;
    font-size: var(--step-0);
    color: var(--navy-80);
  }

  .zap__numero a,
  .zap__email a {
    color: var(--navy);
    font-weight: 600;
  }

  .contato {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .contato__desvio {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--navy-60);
  }

  .contato__block + .contato__block {
    margin-top: var(--space-xl);
  }

  /* A mesma entrelinha do rótulo do formulário: com 14,5px aqui e 21,5px lá,
     as duas colunas começavam no mesmo pixel mas o texto de cada uma assentava
     em alturas diferentes, e o desalinhamento ficava à vista. */
  .contato__title {
    line-height: 1.6;
    padding-bottom: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy-60);
    border-bottom: 1px solid var(--rule);
  }

  .contato__steps {
    margin: var(--space-m) 0 0;
    padding-left: 1.1rem;
  }

  .contato__steps li {
    font-weight: 300;
    color: var(--navy-80);
  }

  .contato__steps li + li {
    margin-top: var(--space-s);
  }

  .contato__text {
    margin-top: var(--space-m);
    font-weight: 300;
    line-height: 1.6;
    color: var(--navy-80);
  }

  @media (max-width: 920px) {
    .contato {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
