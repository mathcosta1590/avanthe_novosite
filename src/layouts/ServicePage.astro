---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaSection from '../components/CtaSection.astro';
import { serviceContent } from '../data/services-content.js';
import Cronograma from '../components/Cronograma.astro';
import { services } from '../data/site.js';

const { slug } = Astro.props;
const content = serviceContent[slug];
const meta = services.find((s) => s.slug === slug);
const others = services.filter((s) => s.slug !== slug);
---

<Base title={content.title} description={meta.metaDescription}>
  <PageHero eyebrow="Serviço" title={content.title} lede={content.lede} />

  <section class="section section--tall">
    <div class="shell service">
      <div class="prose service__body">
        {content.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      {
        content.aside && (
          <aside class="service__aside-bloco">
            <h2 class="service__aside-title">{content.aside.title}</h2>
            <ul class="service__list">
              {content.aside.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    {
      content.foto && (
        <div class="shell">
          <figure class="obra-prova">
            <img
              class="obra-prova__foto"
              src={content.foto.src}
              alt={content.foto.alt}
              width="1600"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="obra-prova__legenda">
              <span class="obra-prova__rotulo">Obra entregue</span>
              <a class="obra-prova__link" href={`/portfolio/${content.foto.obra.slug}`}>
                {content.foto.obra.nome}
                <span class="obra-prova__seta" aria-hidden="true">
                  &rarr;
                </span>
              </a>
              <span class="obra-prova__tipo">{content.foto.obra.tipo}</span>
            </figcaption>
          </figure>
        </div>
      )
    }
  </section>

  {
    content.cronograma && (
      <section class="section section--tall">
        <div class="shell">
          <Cronograma
            titulo={content.cronograma.titulo}
            etapas={content.cronograma.etapas}
            semanas={content.cronograma.semanas}
            nota={content.cronograma.nota}
          />
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="shell">
      <h2 class="eyebrow">Outras frentes</h2>
      <ul class="others">
        {
          others.map((other) => (
            <li>
              <a class="others__link" href={`/${other.slug}`}>
                <span class="others__name">{other.title}</span>
                <span class="others__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaSection
    title="Vamos olhar a sua obra de perto."
    text="Preencha o formulário e receba um diagnóstico técnico para o seu projeto. Respondemos em até um dia útil."
  />
</Base>

<style>
  /*
   * Coluna única.
   *
   * Em duas colunas, a direita ficava com um retrato 3:4 estreito e alto ao
   * lado de um texto de altura completamente diferente: o texto acabava antes,
   * a foto continuava, e sobrava um vazio grande embaixo à esquerda. Não era
   * desalinhamento, era a estrutura.
   *
   * Empilhado, cada coisa ocupa a largura que merece: o texto na medida de
   * leitura, a foto como faixa cheia. Nada fica ragged porque nada disputa
   * altura com nada.
   */
  .service {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* A foixa fica fora da grade, atravessando a largura toda. Foi a foto
     dentro da coluna estreita que quebrava a estrutura: alta demais ao lado
     de um texto de outra altura, deixava um vazio embaixo à esquerda. Os
     pontos, que são curtos, convivem com o texto sem esse efeito. */
  .obra-prova {
    margin: var(--space-2xl) 0 0;
  }

  /*
   * A foto como prova, não como enfeite.
   *
   * Solta na coluna, sem legenda, ela não dizia o que era: parecia banco de
   * imagem. Nomeada e ligada ao case, ela passa a sustentar o texto ao lado —
   * é uma obra que existe, com página própria e fotos de antes e depois.
   *
   * A legenda repete a régua do bloco abaixo (filete navy de 2px) para a
   * coluna inteira ler como um sistema, e não como peças empilhadas.
   */
  .obra-prova__foto {
    display: block;
    width: 100%;
    height: auto;
    /* 2:1, que é a proporção em que os arquivos foram recortados: assim o
       cover não descarta nada. Em retrato, nesta largura, a foto viraria um
       painel de dois metros de altura. */
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }

  .obra-prova__legenda {
    display: grid;
    gap: var(--space-3xs);
    margin-top: var(--space-s);
    padding-top: var(--space-xs);
    border-top: 2px solid var(--navy);
  }

  .obra-prova__rotulo {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy-60);
  }

  .obra-prova__link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
  }

  .obra-prova__link:hover,
  .obra-prova__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .obra-prova__seta {
    transition: transform 0.25s var(--ease);
  }

  .obra-prova__link:hover .obra-prova__seta {
    transform: translateX(0.2em);
  }

  .obra-prova__tipo {
    font-size: var(--step--1);
    font-weight: 300;
    color: var(--navy-80);
  }

  .service__aside-bloco {
    padding-top: var(--space-s);
    border-top: 2px solid var(--navy);
  }

  .service__aside-title {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .service__list {
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
  }

  .service__list li {
    padding: var(--space-xs) 0;
    font-size: var(--step-0);
    font-weight: 300;
    color: var(--navy-80);
    border-bottom: 1px solid var(--rule);
  }

  .others {
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .others li {
    border-bottom: 1px solid var(--rule);
  }

  .others__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding: var(--space-m) 0;
    text-decoration: none;
    transition: padding-left 0.25s var(--ease);
  }

  .others__link:hover {
    padding-left: var(--space-s);
  }

  .others__name {
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .others__arrow {
    color: var(--navy-60);
  }

  @media (max-width: 860px) {
    .service {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    /* No celular a tela é estreita e 2:1 deixaria a faixa baixa demais para
       se ler alguma coisa dentro dela. */
    .obra-prova__foto {
      aspect-ratio: 3 / 2;
    }

    .obra-prova {
      margin-top: var(--space-xl);
    }
  }
</style>
